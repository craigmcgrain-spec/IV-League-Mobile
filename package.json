{
  "name": "iv-league-mobile",
  "version": "1.0.2",
  "main": "index.ts",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "expo": "~57.0.19",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-print": "~57.0.1",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-quick-crypto": "^1.1.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "prebuild": "expo prebuild"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition"
        ],
        "listUnknownPackages": true
      }
    }
  },
  "private": true
}
